<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Your Story | The Daily Chronicle</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/header') %>

<main class="edit-post-page">
    <div class="edit-post-container">

        <div class="edit-post-heading">
            <span class="edit-post-label">THE DAILY CHRONICLE</span>
            <h1>Edit Your Story</h1>
            <p>Update your article, organize your photos and keep your story fresh.</p>
        </div>

        <% if (error) { %>
            <div class="form-error">
                <%= error %>
            </div>
            <% } %>

                <form action="/posts/<%= post.id %>/edit" method="POST" enctype="multipart/form-data"
                    class="edit-post-form">

                    <div class="edit-post-main">

                        <section class="edit-post-card">
                            <div class="edit-post-section-heading">
                                <h2>Story Details</h2>
                                <p>Make changes to your title and introduction.</p>
                            </div>

                            <div class="form-group">
                                <label for="title">Post Title</label>
                                <input type="text" id="title" name="title" maxlength="200" value="<%= post.title %>"
                                    required>
                            </div>

                            <div class="form-group">
                                <label for="excerpt">Short Description</label>
                                <textarea id="excerpt" name="excerpt" maxlength="500"
                                    rows="4"><%= post.excerpt || '' %></textarea>
                            </div>

                            <div class="form-group">
                                <label for="content">Article Content</label>
                                <textarea id="content" name="content" rows="16" required><%= post.content %></textarea>
                            </div>
                        </section>

                    </div>

                    <aside class="edit-post-sidebar">

                        <section class="edit-post-card">
                            <div class="edit-post-section-heading">
                                <h2>Publish Details</h2>
                                <p>Organize your article.</p>
                            </div>

                            <div class="form-group">
                                <label for="category_id">Category</label>
                                <select id="category_id" name="category_id">
                                    <option value="">Select Category</option>

                                    <% categories.forEach(category=> { %>
                                        <option value="<%= category.id %>" <%=String(post.category_id || ''
                                            )===String(category.id) ? 'selected' : '' %>>
                                            <%= category.name %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>
                        </section>

                        <section class="edit-post-card">
                            <div class="edit-post-section-heading">
                                <h2>Existing Photos</h2>
                                <p>Manage photos already attached to your story.</p>
                            </div>

                            <% if (images && images.length> 0) { %>
                                <p class="edit-post-help">Select the photos you want to remove.</p>

                                <div class="edit-image-grid">
                                    <% images.forEach(image=> { %>
                                        <div class="edit-image-item">
                                            <img src="<%= image.image_path %>" alt="Post photo">

                                            <label class="delete-image-option">
                                                <input type="checkbox" name="delete_image_ids" value="<%= image.id %>">
                                                Remove this photo
                                            </label>
                                        </div>
                                        <% }) %>
                                </div>
                                <% } else { %>
                                    <div class="edit-post-no-images">
                                        No photos uploaded yet.
                                    </div>
                                    <% } %>
                        </section>

                        <section class="edit-post-card">
                            <div class="edit-post-section-heading">
                                <h2>Add New Photos</h2>
                                <p>Upload additional photos to your story.</p>
                            </div>

                            <div class="form-group">
                                <label for="images">Choose Photos</label>

                                <input type="file" id="images" name="images"
                                    accept="image/jpeg,image/png,image/gif,image/webp,image/avif" multiple>

                                <small>
                                    Up to 100 new photos. Maximum 5 MB per photo.
                                </small>

                                <p id="imageCount" class="edit-post-help">
                                    No new photos selected.
                                </p>

                                <div id="imagePreview" class="edit-image-grid"></div>
                            </div>
                        </section>

                        <div class="edit-post-submit">
                            <button type="submit" class="button">
                                Save Changes
                            </button>

                            <a href="/dashboard" class="button button-secondary">
                                Cancel
                            </a>
                        </div>

                    </aside>

                </form>
    </div>
</main>


    <style>
        .edit-image-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .edit-image-item {
            min-width: 0;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 8px;
            overflow: hidden;
        }

        .edit-image-item img {
            width: 100%;
            height: 130px;
            object-fit: cover;
            display: block;
            border-radius: 7px;
        }

        .delete-image-option {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-top: 10px;
            font-size: 13px;
            cursor: pointer;
        }

        .delete-image-option input {
            width: auto;
        }

        #imagePreview .edit-image-item {
            position: relative;
        }

        .remove-new-image {
            width: 100%;
            margin-top: 8px;
            padding: 7px;
            border: none;
            border-radius: 5px;
            background: #b42318;
            color: white;
            cursor: pointer;
        }

        @media (max-width: 600px) {
            .edit-image-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }
    </style>
<script src="/js/edit-post.js"></script>

    <%- include('../partials/footer') %>
</body>
</html>