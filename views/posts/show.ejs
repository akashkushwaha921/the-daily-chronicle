<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> | The Daily Chronicle
    </title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
  
/* =========================================
   PROFESSIONAL ARTICLE DETAIL PAGE
========================================= */

.article-detail-page {
    padding-top: 35px;
    padding-bottom: 35px;
    color: #263247;
}

/* Article Card */

.article-detail-page .article-page {
    max-width: 850px;
    margin: 0 auto;
    padding: 42px;
    background: #ffffff;
    border: 1px solid #e8ebf2;
    border-radius: 18px;
    box-shadow: 0 8px 35px rgba(30, 45, 75, 0.06);
}

/* Category */

.article-detail-page .article-category {
    display: inline-block;
    padding: 7px 14px;
    margin-bottom: 18px;
    color: #4f46c8;
    background: #f0efff;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 700;
}

/* Title */

.article-detail-page .article-title {
    color: #172033;
    font-size: 38px;
    line-height: 1.3;
    letter-spacing: -0.7px;
    margin: 0 0 18px;
    overflow-wrap: anywhere;
}

/* Author and Date */

.article-detail-page .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    color: #8490a3;
    font-size: 14px;
    padding-bottom: 22px;
    margin-bottom: 22px;
    border-bottom: 1px solid #edf0f5;
}

.article-detail-page .author-link {
    color: #6356d9;
    font-weight: 700;
    text-decoration: none;
}

.article-detail-page .author-link:hover {
    text-decoration: underline;
}

/* Excerpt */

.article-detail-page .article-page > p:not(.login-notice) {
    padding: 17px 20px;
    margin: 0 0 25px;
    background: #f7f8fc;
    border-left: 4px solid #6878df;
    border-radius: 5px 10px 10px 5px;
    color: #46536a;
    font-size: 16px;
    line-height: 1.8;
}

/* Photo Gallery */

.article-detail-page .article-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
    margin: 28px 0 32px;
}

.article-detail-page .article-gallery-item {
    overflow: hidden;
    border-radius: 13px;
    background: #f1f5f9;
}

.article-detail-page .article-gallery-item img {
    display: block;
    width: 100%;
    height: 260px;
    object-fit: cover;
    transition: transform 0.35s ease;
}

.article-detail-page .article-gallery-item img:hover {
    transform: scale(1.045);
}

@media (min-width: 700px) {
    .article-detail-page .article-gallery-item:first-child:nth-last-child(odd) {
        grid-column: 1 / -1;
    }

    .article-detail-page .article-gallery-item:first-child:nth-last-child(odd) img {
        height: 410px;
    }
}

/* Article Content */

.article-detail-page .article-content {
    color: #354258;
    font-size: 17px;
    line-height: 2;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    margin-top: 25px;
}

/* Article Buttons */

.article-detail-page .article-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 35px;
    padding-top: 22px;
    border-top: 1px solid #edf0f5;
}

.article-detail-page .article-action {
    padding: 11px 19px;
    border: 1px solid #dce2ed;
    border-radius: 9px;
    background: #ffffff;
    color: #39465d;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
}

.article-detail-page .article-action:hover {
    background: #f1f3ff;
    border-color: #6878df;
    color: #4f46c8;
    transform: translateY(-2px);
}

.article-detail-page .article-action.active {
    background: #eef0ff;
    border-color: #6878df;
    color: #4f46c8;
}

/* Login Notice */

.article-detail-page .login-notice {
    margin-top: 22px;
    padding: 14px 17px;
    background: #f7f8fc;
    border-radius: 9px;
    color: #64748b;
    font-size: 14px;
}

/* Report Messages */

.article-detail-page .report-message {
    margin-bottom: 22px;
    padding: 14px 17px;
    border-radius: 9px;
    font-size: 14px;
    line-height: 1.6;
}

.article-detail-page .report-success {
    background: #ecfdf3;
    color: #166534;
    border: 1px solid #bbf7d0;
}

.article-detail-page .report-warning {
    background: #fff8e6;
    color: #92400e;
    border: 1px solid #fde68a;
}

/* Report Form */

.article-detail-page .report-section {
    margin-top: 30px;
    padding-top: 23px;
    border-top: 1px solid #edf0f5;
}

.article-detail-page .report-section h3 {
    margin-bottom: 17px;
    color: #273449;
    font-size: 19px;
}

.article-detail-page .report-section label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: #46536a;
    font-size: 14px;
}

.article-detail-page .report-section select,
.article-detail-page .report-section textarea {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    margin-bottom: 14px;
    border: 1px solid #dce2ed;
    border-radius: 9px;
    background: #ffffff;
    color: #354258;
    font: inherit;
}

.article-detail-page .report-section textarea {
    min-height: 90px;
    resize: vertical;
}

.article-detail-page .report-section select:focus,
.article-detail-page .report-section textarea:focus {
    outline: none;
    border-color: #6878df;
    box-shadow: 0 0 0 3px rgba(104, 120, 223, 0.10);
}

.article-detail-page .report-section button {
    padding: 11px 19px;
    border: none;
    border-radius: 8px;
    background: #dc3545;
    color: #ffffff;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease;
}

.article-detail-page .report-section button:hover {
    background: #bd2535;
}

/* Comments Card */

.article-detail-page .comments-section {
    max-width: 850px;
    margin: 28px auto 45px;
    padding: 35px 42px;
    background: #ffffff;
    border: 1px solid #e8ebf2;
    border-radius: 18px;
    box-shadow: 0 8px 30px rgba(30, 45, 75, 0.045);
}

.article-detail-page .comments-title {
    font-size: 25px;
    color: #172033;
    margin-bottom: 25px;
    padding-bottom: 16px;
    border-bottom: 1px solid #edf0f5;
}

/* Comment Form */

.article-detail-page .comment-form {
    margin-bottom: 32px;
}

.article-detail-page .comment-form label {
    display: block;
    font-weight: 700;
    margin-bottom: 11px;
    color: #354258;
}

.article-detail-page .comment-form textarea {
    width: 100%;
    min-height: 115px;
    padding: 15px;
    border: 1px solid #dce2ed;
    border-radius: 10px;
    resize: vertical;
    font-family: inherit;
    font-size: 15px;
    box-sizing: border-box;
    transition: border 0.2s ease;
}

.article-detail-page .comment-form textarea:focus {
    outline: none;
    border-color: #6878df;
    box-shadow: 0 0 0 3px rgba(104, 120, 223, 0.10);
}

.article-detail-page .comment-submit {
    margin-top: 12px;
    padding: 11px 22px;
    border: none;
    border-radius: 9px;
    background: #5265d8;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease;
}

.article-detail-page .comment-submit:hover {
    background: #394dbd;
}

/* Comments List */

.article-detail-page .comments-list {
    margin-top: 25px;
}

.article-detail-page .comment-item {
    padding: 22px 0;
    border-bottom: 1px solid #edf0f5;
}

.article-detail-page .comment-item:last-child {
    border-bottom: none;
}

.article-detail-page .comment-author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 13px;
}

.article-detail-page .comment-author img {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #edf0f5;
}

.article-detail-page .comment-author-name {
    color: #354258;
    font-weight: 700;
    text-decoration: none;
}

.article-detail-page .comment-author-name:hover {
    color: #5265d8;
}

.article-detail-page .comment-content {
    color: #526075;
    line-height: 1.8;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

.article-detail-page .comment-date {
    display: block;
    margin-top: 11px;
    color: #929caf;
    font-size: 12px;
}

.article-detail-page .comment-report {
    margin-top: 15px;
    padding-top: 12px;
    border-top: 1px solid #f0f2f6;
}

.article-detail-page .no-comments {
    color: #8490a3;
    padding: 15px 0;
}

/* Mobile Responsive */

@media (max-width: 700px) {
    .article-detail-page {
        padding-top: 15px;
        padding-bottom: 15px;
    }

    .article-detail-page .article-page,
    .article-detail-page .comments-section {
        margin: 15px 10px;
        padding: 22px 18px;
        border-radius: 13px;
    }

    .article-detail-page .article-title {
        font-size: 28px;
        letter-spacing: -0.3px;
    }

    .article-detail-page .article-content {
        font-size: 16px;
        line-height: 1.85;
    }

    .article-detail-page .article-gallery {
        grid-template-columns: 1fr;
        gap: 11px;
    }

    .article-detail-page .article-gallery-item img {
        height: 240px;
    }

    .article-detail-page .article-actions {
        gap: 9px;
    }

    .article-detail-page .article-action {
        padding: 10px 13px;
        font-size: 13px;
    }

    .article-detail-page .comments-title {
        font-size: 22px;
    }
}
/* Professional Author Name Link */
.article-detail-page .author-link {
    display: inline-flex;
    align-items: center;
    padding: 5px 13px;
    margin-left: 5px;
    border-radius: 20px;
    background: #f0f4ff;
    color: #3156a3;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    transition: all 0.25s ease;
}

.article-detail-page .author-link:hover {
    background: #3156a3;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(49, 86, 163, 0.18);
}

    </style>
</head>

<body>

    <%- include('../partials/header') %>

    <main class="container article-detail-page">

            <article class="article-page">

                <!-- Report Success / Duplicate Message -->

                <% if (reportStatus==='success' ) { %>

                    <div class="report-message report-success">
                        Your report has been submitted successfully.
                        Thank you for helping us!
                    </div>

                    <% } else if (reportStatus==='duplicate' ) { %>

                        <div class="report-message report-warning">
                            You have already reported this content.
                        </div>

                        <% } %>

                            <% if (post.category_name) { %>
                                <div class="article-category">
                                    <%= post.category_name %>
                                </div>
                                <% } %>

                                    <h1 class="article-title">
                                        <%= post.title %>
                                    </h1>

                                    <div class="article-meta">
                                        By

                                        <% if (post.user_id && post.author_name) { %>
                                            <a href="/author/<%= post.user_id %>" class="author-link">
                                                <%= post.author_name %>
                                            </a>
                                            <% } else { %>
                                                Community Author
                                                <% } %>

                                                    <% if (post.published_at) { %>
                                                        | <%= new Date(post.published_at).toLocaleDateString('en-IN') %>
                                                            <% } %>
                                    </div>

                                    <% if (post.excerpt) { %>
                                        <p>
                                            <strong>
                                                <%= post.excerpt %>
                                            </strong>
                                        </p>
                                        <% } %>

                                            <% if (images && images.length> 0) { %>

                                                <div class="article-gallery">

                                                    <% images.forEach(image=> { %>

                                                        <div class="article-gallery-item">
                                                            <img src="<%= image.image_path %>" alt="<%= post.title %>"
                                                                loading="lazy">
                                                        </div>

                                                        <% }) %>

                                                </div>

                                                <% } %>


                                                    <div class="article-content">
                                                        <%= post.content %>
                                                    </div>

                                                    <div class="article-actions">

                                                        <% if (currentUser) { %>

                                                            <button type="button" id="likeButton"
                                                                data-post-id="<%= post.id %>"
                                                                class="article-action <%= post.liked ? 'active' : '' %>">

                                                                ❤️ <span id="likeText">
                                                                    <%= post.liked ? 'Liked' : 'Like' %>
                                                                </span>

                                                                (<span id="likesCount">
                                                                    <%= post.likes_count %>
                                                                </span>)

                                                            </button>

                                                            <button type="button" id="bookmarkButton"
                                                                data-post-id="<%= post.id %>"
                                                                class="article-action <%= post.bookmarked ? 'active' : '' %>">

                                                                🔖 <span id="bookmarkText">
                                                                    <%= post.bookmarked ? 'Bookmarked' : 'Bookmark' %>
                                                                </span>

                                                            </button>

                                                            <% } %>

                                                                <button type="button" id="shareButton"
                                                                    class="article-action"
                                                                    data-title="<%= post.title %>">

                                                                    🔗 Share

                                                                </button>

                                                    </div>

                                                    <% if (!currentUser) { %>
                                                        <p class="login-notice">
                                                            Please <a href="/auth/login">login</a> to like or bookmark
                                                            this article.
                                                        </p>
                                                        <% } %>


                                                                    <!-- Article Report Form -->

                                                                    <% if (currentUser && String(currentUser.id)
                                                                        !==String(post.user_id)) { %>

                                                                        <div class="report-section">

                                                                            <form action="/reports/post/<%= post.id %>"
                                                                                method="POST">

                                                                                <input type="hidden" name="_csrf"
                                                                                    value="<%= csrfToken %>">

                                                                                <h3>Report this Article</h3>

                                                                                <label for="article-report-reason">
                                                                                    Reason
                                                                                </label>

                                                                                <select id="article-report-reason"
                                                                                    name="reason" required>
                                                                                    <option value="">Select a reason
                                                                                    </option>
                                                                                    <option value="spam">Spam</option>
                                                                                    <option value="harassment">
                                                                                        Harassment
                                                                                    </option>
                                                                                    <option value="misinformation">
                                                                                        Misinformation
                                                                                    </option>
                                                                                    <option value="inappropriate">
                                                                                        Inappropriate
                                                                                        Content</option>
                                                                                    <option value="other">Other</option>
                                                                                </select>

                                                                                <textarea name="details"
                                                                                    maxlength="1000"
                                                                                    placeholder="Additional details (optional)"></textarea>

                                                                                <button type="submit">
                                                                                    Submit Report
                                                                                </button>

                                                                            </form>

                                                                        </div>

                                                                        <% } %>

            </article>

            <!-- Comments Section -->

            <section class="comments-section">

                <h2 class="comments-title">
                    Comments (<%= comments.length %>)
                </h2>

                <% if (currentUser) { %>

                    <form action="/comments/<%= post.id %>" method="POST" class="comment-form">

                        <label for="comment-content">
                            Write a Comment
                        </label>

                        <textarea id="comment-content" name="content" maxlength="2000"
                            placeholder="Share your thoughts..." required></textarea>

                        <button type="submit" class="comment-submit">
                            Post Comment
                        </button>

                    </form>

                    <% } else { %>

                        <p class="login-notice">
                            Please <a href="/auth/login">login</a> to write a comment.
                        </p>

                        <% } %>

                            <div class="comments-list">

                                <% if (!comments || comments.length===0) { %>

                                    <p class="no-comments">
                                        No comments yet. Be the first to comment!
                                    </p>

                                    <% } else { %>

                                        <% comments.forEach(comment=> { %>

                                            <article class="comment-item">

                                                <div class="comment-author">

                                                    <% if (comment.author_image) { %>
                                                        <img src="<%= comment.author_image %>" alt="Profile photo">
                                                        <% } %>

                                                            <a href="/author/<%= comment.author_id %>"
                                                                class="comment-author-name">

                                                                <%= comment.author_name %>

                                                            </a>

                                                </div>

                                                <p class="comment-content">
                                                    <%= comment.content %>
                                                </p>

                                                <small class="comment-date">
                                                    <%= new Date(comment.created_at).toLocaleString('en-IN') %>
                                                </small>

                                                <!-- Comment Report Form -->

                                                <% if (currentUser && String(currentUser.id)
                                                    !==String(comment.author_id)) { %>

                                                    <div class="comment-report">

                                                        <form action="/reports/comment/<%= comment.id %>" method="POST">

                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                                            <div class="report-section">

                                                                <h3>Report this Comment</h3>

                                                                <label for="comment-reason-<%= comment.id %>">
                                                                    Reason
                                                                </label>

                                                                <select id="comment-reason-<%= comment.id %>"
                                                                    name="reason" required>

                                                                    <option value="">Select a reason</option>
                                                                    <option value="spam">Spam</option>
                                                                    <option value="harassment">Harassment</option>
                                                                    <option value="misinformation">Misinformation
                                                                    </option>
                                                                    <option value="inappropriate">Inappropriate Content
                                                                    </option>
                                                                    <option value="other">Other</option>

                                                                </select>

                                                                <textarea name="details" maxlength="1000"
                                                                    placeholder="Additional details (optional)"></textarea>

                                                                <button type="submit">
                                                                    Report Comment
                                                                </button>

                                                            </div>

                                                        </form>

                                                    </div>

                                                    <% } %>

                                            </article>

                                            <% }) %>

                                                <% } %>

                            </div>

            </section>

        </main>

        <%- include('../partials/footer') %>

            <script src="/js/share.js" defer></script>

            <% if (currentUser) { %>
                <script src="/js/main.js" defer></script>
                <% } %>

</body>

</html>