<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %> | The Daily Chronicle
    </title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        body {
            background: #f4f6fa;
        }

        .articles-container {
            max-width: 1250px;
            margin: 40px auto;
            padding: 0 25px;
        }

        .articles-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
        }

        .articles-header h1 {
            color: #172033;
            font-size: 28px;
        }

        .back-link {
            color: #ffffff;
            background: #172033;
            padding: 11px 18px;
            border-radius: 7px;
            text-decoration: none;
        }

        .table-wrapper {
            background: #ffffff;
            border-radius: 12px;
            overflow-x: auto;
            border: 1px solid #e8ebf1;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 750px;
        }

        th,
        td {
            padding: 16px;
            text-align: left;
            border-bottom: 1px solid #edf0f4;
            font-size: 14px;
        }

        th {
            background: #172033;
            color: #ffffff;
        }

        td {
            color: #46536b;
        }

        .status {
            display: inline-block;
            padding: 6px 11px;
            border-radius: 20px;
            font-size: 12px;
            text-transform: capitalize;
            background: #edf0f4;
        }

        .status-published {
            background: #dcfce7;
            color: #166534;
        }

        .status-pending {
            background: #fef3c7;
            color: #92400e;
        }

        .status-draft {
            background: #e0e7ff;
            color: #3730a3;
        }

        .review-btn {
            display: inline-block;
            background: #2563eb;
            color: white;
            padding: 8px 12px;
            border-radius: 6px;
            text-decoration: none;
            margin-bottom: 8px;
        }

        .review-btn:hover {
            background: #1d4ed8;
        }

        .publish-btn {
            border: none;
            background: #16794a;
            color: white;
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
        }

        .publish-btn:hover {
            background: #105d38;
        }

        .delete-btn {
            background: #dc2626;
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
        }

        .delete-btn:hover {
            background: #b91c1c;
        }

        .action-form {
            margin-top: 8px;
        }

        .empty-message {
            text-align: center;
            padding: 35px;
            color: #778196;
        }

        @media (max-width: 600px) {
            .articles-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .articles-header h1 {
                font-size: 23px;
            }

            .articles-container {
                padding: 0 15px;
            }
        }
    </style>
</head>

<body>

    <%- include('../partials/header') %>

        <main class="articles-container">

            <!-- HEADER -->
            <header class="articles-header">

                <h1>Articles Management</h1>

                <a href="/admin" class="back-link">
                    ← Back to Dashboard
                </a>

            </header>

            <!-- ARTICLES TABLE -->
            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Article Title</th>
                            <th>Author</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (articles.length> 0) { %>

                            <% articles.forEach(article=> { %>

                                <tr>

                                    <td>
                                        <%= article.id %>
                                    </td>

                                    <td>
                                        <%= article.title %>
                                    </td>

                                    <td>
                                        <%= article.author_name || 'Unknown' %>
                                    </td>

                                    <td>
                                        <%= article.category_name || 'Uncategorized' %>
                                    </td>

                                    <td>
                                        <span class="status status-<%= article.status %>">
                                            <%= article.status %>
                                        </span>
                                    </td>

                                    <td>

                                        <!-- REVIEW ARTICLE -->
                                        <a href="/admin/articles/<%= article.id %>" class="review-btn">
                                            Review
                                        </a>

                                        <!-- PUBLISH ARTICLE -->
                                        <% if (article.status==='pending' || article.status==='draft' ) { %>

                                            <form action="/admin/articles/<%= article.id %>/publish" method="POST"
                                                class="publish-form">

                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                                <button type="submit" class="publish-btn">
                                                    Publish
                                                </button>

                                            </form>

                                            <% } %>

                                                <!-- DELETE ARTICLE -->
                                                <form action="/admin/articles/<%= article.id %>/delete" method="POST"
                                                    class="action-form delete-form"
                                                    data-confirm="WARNING: Are you sure you want to delete this article? Its comments, likes and bookmarks will also be permanently deleted.">

                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                                    <button type="submit" class="delete-btn">
                                                        Delete
                                                    </button>

                                                </form>

                                    </td>

                                </tr>

                                <% }); %>

                                    <% } else { %>

                                        <tr>
                                            <td colspan="6" class="empty-message">
                                                No articles found.
                                            </td>
                                        </tr>

                                        <% } %>

                    </tbody>

                </table>

            </div>

        </main>

        <!-- EXTERNAL JAVASCRIPT -->
        <script src="/js/admin.js" defer></script>

        <%- include('../partials/footer') %>

</body>

</html>