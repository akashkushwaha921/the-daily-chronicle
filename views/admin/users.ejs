<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %> | The Daily Chronicle
    </title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .users-page {
            max-width: 1250px;
            margin: 50px auto;
            padding: 0 25px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .page-title h1 {
            font-size: 36px;
            color: #172033;
            margin: 0 0 8px;
        }

        .page-title p {
            color: #666;
            margin: 0;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 20px;
            background: #172033;
            color: #fff;
            text-decoration: none;
            border-radius: 7px;
            font-weight: 600;
            white-space: nowrap;
            transition: 0.2s;
        }

        .back-btn:hover {
            background: #293b5d;
        }

        .users-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 20px;
        }

        .search-form {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .search-input {
            width: 320px;
            max-width: 100%;
            padding: 12px 15px;
            border: 1px solid #ddd;
            border-radius: 7px;
            font-size: 14px;
            outline: none;
        }

        .search-input:focus {
            border-color: #172033;
        }

        .search-btn {
            padding: 12px 22px;
            background: #172033;
            color: white;
            border: none;
            border-radius: 7px;
            cursor: pointer;
            font-weight: 600;
        }

        .search-btn:hover {
            background: #293b5d;
        }

        .reset-btn {
            padding: 12px 18px;
            background: #e9e9e9;
            color: #333;
            text-decoration: none;
            border-radius: 7px;
        }

        .reset-btn:hover {
            background: #ddd;
        }

        .users-count {
            color: #555;
            font-size: 14px;
        }

        .users-count strong {
            color: #172033;
        }

        .users-table-wrapper {
            width: 100%;
            overflow-x: auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
        }

        .users-table {
            width: 100%;
            min-width: 950px;
            border-collapse: collapse;
        }

        .users-table th {
            background: #172033;
            color: #fff;
            padding: 17px;
            text-align: left;
            font-weight: 600;
        }

        .users-table td {
            padding: 17px;
            border-bottom: 1px solid #eee;
            color: #333;
        }

        .users-table tbody tr:hover {
            background: #f8f9fc;
        }

        .users-table tbody tr:last-child td {
            border-bottom: none;
        }

        .user-id {
            color: #777;
            font-weight: 600;
        }

        .user-name {
            font-weight: 600;
            color: #172033;
        }

        .user-email {
            color: #555;
        }

        .role-badge,
        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: capitalize;
        }

        .role-admin {
            background: #e5edff;
            color: #254a9a;
        }

        .role-reader {
            background: #e8f5ec;
            color: #26733d;
        }

        .status-active {
            background: #e8f5ec;
            color: #26733d;
        }

        .status-blocked {
            background: #fde8e8;
            color: #b42318;
        }

        .action-btn {
            padding: 8px 15px;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .block-btn {
            background: #fde8e8;
            color: #b42318;
        }

        .block-btn:hover {
            background: #f8d0d0;
        }

        .unblock-btn {
            background: #e8f5ec;
            color: #26733d;
        }

        .unblock-btn:hover {
            background: #d2ead9;
        }

        .protected-label {
            color: #777;
            font-size: 13px;
            font-weight: 600;
        }

        .empty-message {
            padding: 45px 20px;
            text-align: center;
            color: #777;
        }

        @media (max-width: 650px) {
            .users-page {
                margin: 25px auto;
                padding: 0 15px;
            }

            .page-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .page-title h1 {
                font-size: 28px;
            }

            .search-form {
                width: 100%;
            }

            .search-input {
                width: 100%;
                flex: 1;
            }
        }
    </style>
</head>

<body>

    <%- include('../partials/header') %>

        <main class="users-page">

            <div class="page-header">

                <div class="page-title">
                    <h1>Users Management</h1>
                    <p>View and manage all registered users.</p>
                </div>

                <a href="/admin" class="back-btn">
                    ← Back to Dashboard
                </a>

            </div>

            <div class="users-toolbar">

                <form action="/admin/users" method="GET" class="search-form">

                    <input type="text" name="search" class="search-input" placeholder="Search by name or email..."
                        value="<%= search || '' %>">

                    <button type="submit" class="search-btn">
                        Search
                    </button>

                    <a href="/admin/users" class="reset-btn">
                        Reset
                    </a>

                </form>

                <div class="users-count">
                    Total Users: <strong>
                        <%= users.length %>
                    </strong>
                </div>

                <a href="/admin/email-all" class="back-btn">
                    ✉ Email All Users
                </a>

            </div>

            <div class="users-table-wrapper">

                <% if (users.length> 0) { %>

                    <table class="users-table">

                        <thead>
                            <tr>
                                <th>Sr. No.</th>
                                <th>User ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Joined On</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% users.forEach((user, index)=> { %>

                                <tr>

                                    <td class="user-id">
                                        <%= index + 1 %>
                                    </td>

                                    <td class="user-id">
                                        <%= user.id %>
                                    </td>

                                    <td class="user-name">
                                        <%= user.name %>
                                    </td>

                                    <td class="user-email">
                                        <%= user.email %>
                                    </td>

                                    <td>
                                        <span
                                            class="role-badge <%= user.role === 'admin' ? 'role-admin' : 'role-reader' %>">
                                            <%= user.role %>
                                        </span>
                                    </td>

                                    <td>
                                        <%= new Date(user.created_at).toLocaleDateString('en-IN') %>
                                    </td>

                                    <td>
                                        <% if (user.is_blocked) { %>
                                            <span class="status-badge status-blocked">
                                                Blocked
                                            </span>
                                            <% } else { %>
                                                <span class="status-badge status-active">
                                                    Active
                                                </span>
                                                <% } %>
                                    </td>

                                    <td>

                                        <% if (user.role==='admin' ) { %>

                                            <span class="protected-label">
                                                Protected
                                            </span>

                                            <% } else if (String(user.id)===String(currentAdminId)) { %>

                                                <span class="protected-label">
                                                    Current Admin
                                                </span>

                                                <% } else if (user.is_blocked) { %>

                                                    <form action="/admin/users/<%= user.id %>/unblock" method="POST">

                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                                        <button type="submit" class="action-btn unblock-btn">
                                                            Unblock
                                                        </button>

                                                    </form>

                                                    <% } else { %>

                                                        <form action="/admin/users/<%= user.id %>/block" method="POST"
                                                            data-confirm="Are you sure you want to block this user?">

                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                                            <button type="submit" class="action-btn block-btn">
                                                                Block
                                                            </button>

                                                        </form>

                                                        <% } %>

                                    </td>

                                </tr>

                                <% }) %>

                        </tbody>

                    </table>

                    <% } else { %>

                        <div class="empty-message">
                            <h3>No Users Found</h3>
                            <p>Try searching with another name or email.</p>
                        </div>

                        <% } %>

            </div>

        </main>

        <script src="/js/admin-users.js"></script>

        <%- include('../partials/footer') %>

</body>

</html>