<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %> | The Daily Chronicle
    </title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .comments-page {
            max-width: 1250px;
            margin: 50px auto;
            padding: 0 25px;
        }

        /* PAGE HEADER */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .page-title h1 {
            font-size: 36px;
            color: #172033;
            margin: 0 0 8px;
        }

        .page-title p {
            color: #666;
            margin: 0;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            padding: 12px 20px;
            background: #172033;
            color: white;
            text-decoration: none;
            border-radius: 7px;
            font-weight: 600;
            white-space: nowrap;
            transition: 0.2s;
        }

        .back-btn:hover {
            background: #293b5d;
        }

        /* SEARCH */
        .comments-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 20px;
        }

        .search-form {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .search-input {
            width: 320px;
            max-width: 100%;
            padding: 12px 15px;
            border: 1px solid #ddd;
            border-radius: 7px;
            font-size: 14px;
            outline: none;
        }

        .search-input:focus {
            border-color: #172033;
        }

        .search-btn {
            padding: 12px 22px;
            background: #172033;
            color: white;
            border: none;
            border-radius: 7px;
            cursor: pointer;
            font-weight: 600;
        }

        .search-btn:hover {
            background: #293b5d;
        }

        .reset-btn {
            padding: 12px 18px;
            background: #e9e9e9;
            color: #333;
            text-decoration: none;
            border-radius: 7px;
        }

        .reset-btn:hover {
            background: #ddd;
        }

        .comments-count {
            color: #555;
            font-size: 14px;
        }

        .comments-count strong {
            color: #172033;
        }

        /* TABLE */
        .comments-table-wrapper {
            width: 100%;
            overflow-x: auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
        }

        .comments-table {
            width: 100%;
            min-width: 950px;
            border-collapse: collapse;
        }

        .comments-table th {
            background: #172033;
            color: white;
            padding: 17px;
            text-align: left;
            font-weight: 600;
        }

        .comments-table td {
            padding: 17px;
            border-bottom: 1px solid #eee;
            vertical-align: top;
        }

        .comments-table tbody tr:hover {
            background: #f8f9fc;
        }

        .comments-table tbody tr:last-child td {
            border-bottom: none;
        }

        .comment-content {
            max-width: 350px;
            overflow-wrap: anywhere;
            line-height: 1.6;
        }

        .comment-user {
            font-weight: 600;
            color: #172033;
        }

        .comment-date {
            white-space: nowrap;
            color: #666;
        }

        /* DELETE BUTTON */
        .delete-btn {
            padding: 9px 16px;
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.2s;
        }

        .delete-btn:hover {
            background: #b02a37;
        }

        .empty-message {
            padding: 45px 20px;
            text-align: center;
            color: #777;
        }

        @media (max-width: 650px) {
            .comments-page {
                margin: 25px auto;
                padding: 0 15px;
            }

            .page-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .page-title h1 {
                font-size: 28px;
            }

            .search-form {
                width: 100%;
            }

            .search-input {
                width: 100%;
                flex: 1;
            }
        }
    </style>
</head>

<body>

    <%- include('../partials/header') %>

        <main class="comments-page">

            <!-- PAGE HEADER -->
            <div class="page-header">

                <div class="page-title">
                    <h1>Manage Comments</h1>
                    <p>View and manage comments posted by users.</p>
                </div>

                <a href="/admin" class="back-btn">
                    ← Back to Dashboard
                </a>

            </div>

            <!-- SEARCH TOOLBAR -->
            <div class="comments-toolbar">

                <form action="/admin/comments" method="GET" class="search-form">

                    <input type="text" name="search" class="search-input"
                        placeholder="Search comments, users or articles..." value="<%= search || '' %>">

                    <button type="submit" class="search-btn">
                        Search
                    </button>

                    <a href="/admin/comments" class="reset-btn">
                        Reset
                    </a>

                </form>

                <div class="comments-count">
                    Total Comments: <strong>
                        <%= comments.length %>
                    </strong>
                </div>

            </div>

            <!-- COMMENTS TABLE -->
            <div class="comments-table-wrapper">

                <% if (comments.length> 0) { %>

                    <table class="comments-table">

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Article</th>
                                <th>Comment</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% comments.forEach(comment=> { %>

                                <tr>

                                    <td>
                                        <%= comment.id %>
                                    </td>

                                    <td class="comment-user">
                                        <%= comment.user_name || 'Unknown User' %>
                                    </td>

                                    <td>
                                        <%= comment.post_title || 'Article Deleted' %>
                                    </td>

                                    <td class="comment-content">
                                        <%= comment.content %>
                                    </td>

                                    <td class="comment-date">
                                        <%= new Date(comment.created_at).toLocaleDateString('en-IN') %>
                                    </td>

                                    <td>

                                        <form action="/admin/comments/<%= comment.id %>/delete" method="POST"
                                            class="delete-form"
                                            data-confirm="Are you sure you want to permanently delete this comment?">

                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                            <button type="submit" class="delete-btn">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                                <% }) %>

                        </tbody>

                    </table>

                    <% } else { %>

                        <div class="empty-message">
                            <h3>No Comments Found</h3>
                            <p>There are no comments matching your search.</p>
                        </div>

                        <% } %>

            </div>

        </main>

        <!-- DELETE CONFIRMATION SCRIPT -->
        <script src="/js/admin.js" defer></script>

        <%- include('../partials/footer') %>

</body>

</html>