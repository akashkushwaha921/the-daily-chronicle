<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %> | The Daily Chronicle
    </title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        body {
            background: #f4f6fa;
        }

        .categories-container {
            max-width: 1250px;
            margin: 40px auto;
            padding: 0 25px;
        }

        .categories-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
        }

        .categories-header h1 {
            color: #172033;
            font-size: 28px;
        }

        .back-link {
            color: #ffffff;
            background: #172033;
            padding: 11px 18px;
            border-radius: 7px;
            text-decoration: none;
        }

        .category-card {
            background: #ffffff;
            padding: 22px;
            border-radius: 12px;
            border: 1px solid #e8ebf1;
            margin-bottom: 22px;
        }

        .category-card h2 {
            color: #172033;
            font-size: 20px;
            margin: 0 0 18px;
        }

        .category-card p {
            color: #778196;
            font-size: 14px;
            margin: 0;
        }

        .add-category-form {
            display: flex;
            gap: 12px;
        }

        .add-category-form input,
        .search-form input {
            padding: 11px 13px;
            border: 1px solid #dce1e9;
            border-radius: 7px;
            font-size: 14px;
            outline: none;
        }

        .add-category-form input {
            flex: 1;
            min-width: 0;
        }

        .add-category-form input:focus,
        .search-form input:focus {
            border-color: #172033;
        }

        .add-btn {
            border: none;
            background: #16794a;
            color: #ffffff;
            padding: 11px 18px;
            border-radius: 7px;
            cursor: pointer;
        }

        .add-btn:hover {
            background: #105d38;
        }

        .category-list-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .category-list-header h2 {
            margin-bottom: 7px;
        }

        .search-form {
            display: flex;
            gap: 9px;
            flex-wrap: wrap;
        }

        .search-form input {
            width: 220px;
        }

        .search-btn {
            border: none;
            background: #172033;
            color: #ffffff;
            padding: 10px 16px;
            border-radius: 7px;
            cursor: pointer;
        }

        .search-btn:hover {
            background: #263550;
        }

        .reset-btn {
            background: #edf0f4;
            color: #46536b;
            padding: 10px 16px;
            border-radius: 7px;
            text-decoration: none;
        }

        .table-wrapper {
            background: #ffffff;
            border-radius: 12px;
            overflow-x: auto;
            border: 1px solid #e8ebf1;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 650px;
        }

        th,
        td {
            padding: 16px;
            text-align: left;
            border-bottom: 1px solid #edf0f4;
            font-size: 14px;
        }

        th {
            background: #172033;
            color: #ffffff;
        }

        td {
            color: #46536b;
        }

        .category-name {
            color: #172033;
            font-weight: 600;
        }

        .article-count {
            display: inline-block;
            background: #edf0f4;
            color: #46536b;
            padding: 5px 11px;
            border-radius: 20px;
            font-size: 12px;
        }

        .delete-btn {
            background: #dc2626;
            color: #ffffff;
            border: none;
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
        }

        .delete-btn:hover {
            background: #b91c1c;
        }

        .empty-message {
            text-align: center;
            padding: 35px;
            color: #778196;
        }

        @media (max-width: 600px) {
            .categories-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .categories-header h1 {
                font-size: 23px;
            }

            .categories-container {
                padding: 0 15px;
            }

            .add-category-form {
                flex-direction: column;
            }

            .category-list-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .search-form {
                width: 100%;
            }

            .search-form input {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <%- include('../partials/header') %>

        <main class="categories-container">

            <!-- HEADER -->
            <header class="categories-header">

                <h1>Categories Management</h1>

                <a href="/admin" class="back-link">
                    ← Back to Dashboard
                </a>

            </header>

            <!-- ADD CATEGORY -->
            <section class="category-card">

                <h2>Add New Category</h2>

                <form action="/admin/categories/add" method="POST" class="add-category-form">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <input type="text" name="name" placeholder="Enter category name" required maxlength="100">

                    <button type="submit" class="add-btn">
                        Add Category
                    </button>

                </form>

            </section>

            <!-- ALL CATEGORIES -->
            <section class="category-card">

                <div class="category-list-header">

                    <div>
                        <h2>All Categories</h2>

                        <p>
                            Total Categories: <%= categories.length %>
                        </p>
                    </div>

                    <!-- SEARCH -->
                    <form action="/admin/categories" method="GET" class="search-form">

                        <input type="text" name="search" placeholder="Search categories..." value="<%= search %>">

                        <button type="submit" class="search-btn">
                            Search
                        </button>

                        <a href="/admin/categories" class="reset-btn">
                            Reset
                        </a>

                    </form>

                </div>

                <div class="table-wrapper">

                    <table>

                        <thead>
                            <tr>
                                <th>Sr. No.</th>
                                <th>Category Name</th>
                                <th>Slug</th>
                                <th>Articles</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>

                            <% if (categories.length> 0) { %>

                                <% categories.forEach((category, index)=> { %>

                                    <tr>

                                        <td>
                                            <%= index + 1 %>
                                        </td>

                                        <td class="category-name">
                                            <%= category.name %>
                                        </td>

                                        <td>
                                            <%= category.slug %>
                                        </td>

                                        <td>
                                            <span class="article-count">
                                                <%= category.article_count %>
                                            </span>
                                        </td>

                                        <td>

                                            <form action="/admin/categories/<%= category.id %>/delete" method="POST"
                                                class="delete-form"
                                                data-confirm="Are you sure you want to delete this category?">

                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                                <button type="submit" class="delete-btn">
                                                    Delete
                                                </button>

                                            </form>

                                        </td>

                                    </tr>

                                    <% }); %>

                                        <% } else { %>

                                            <tr>
                                                <td colspan="5" class="empty-message">
                                                    No categories found.
                                                </td>
                                            </tr>

                                            <% } %>

                        </tbody>


                    </table>

                </div>

            </section>

        </main>

        <script src="/js/admin.js" defer></script>

        <%- include('../partials/footer') %>

</body>

</html>