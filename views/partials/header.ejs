<header class="site-header">
  <div class="nav container">

    <a class="brand" href="/">
      THE DAILY <span>CHRONICLE</span>
    </a>

    <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false"
      aria-controls="site-navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="navigation-panel" id="site-navigation">

      <nav class="main-navigation" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/#latest">Articles</a>
        <a href="/explore">Explore</a>
        <a href="/about">About</a>
      </nav>

      <div class="nav-user">

        <% if (currentUser) { %>

          <a class="nav-profile" href="/profile">

            <% if (currentUser.profile_image) { %>
              <img src="<%= currentUser.profile_image %>" alt="Profile Photo" class="nav-avatar">
              <% } else { %>
                <span class="nav-avatar nav-avatar-fallback">
                  <%= (currentUser.name || 'U' ).charAt(0).toUpperCase() %>
                </span>
                <% } %>

                  <span class="nav-username">
                    <%= currentUser.name %>
                  </span>

          </a>

          <a class="nav-link" href="/dashboard">
            Dashboard
          </a>

          <a class="nav-link" href="/notifications">
            Notifications

            <% if ( typeof unreadNotificationCount !=='undefined' && unreadNotificationCount> 0
              ) { %>
              <span class="notification-count">
                <%= unreadNotificationCount %>
              </span>
              <% } %>
          </a>

          <a class="nav-cta" href="/posts/new">
            Write Post
          </a>

          <form action="/auth/logout" method="POST" class="logout-form">
            <button type="submit" class="logout-button">
              Logout
            </button>
          </form>

          <% } else { %>

            <a class="nav-link" href="/auth/login">
              Login
            </a>

            <a class="nav-cta" href="/auth/register">
              Register
            </a>

            <a class="write-post-link" href="/auth/login">
              Write Post
            </a>

            <% } %>

      </div>
    </div>

  </div>
</header>

<% if (currentUser && currentUser.role==='admin' ) { %>

  <a href="/admin" class="admin-dashboard-float">
    <span>▦</span>
    Admin Dashboard
  </a>

  <% } %>

    <script src="/js/navigation.js" defer></script>

    <% if (currentUser) { %>
      <script src="/js/notifications.js" defer></script>
      <% } %>