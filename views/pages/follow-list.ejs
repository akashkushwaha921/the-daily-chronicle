<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %> | The Daily Chronicle
    </title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .follow-list-page {
            max-width: 850px;
            margin: 50px auto;
            padding: 25px;
        }

        .follow-list-heading {
            color: #17123d;
            font-size: 28px;
            margin-bottom: 8px;
        }

        .follow-list-subheading {
            color: #77758a;
            margin-bottom: 25px;
        }

        .follow-user-card {
            display: flex;
            align-items: center;
            gap: 18px;
            background: white;
            border: 1px solid #e9e6f2;
            border-radius: 12px;
            padding: 18px;
            margin-bottom: 14px;
        }

        .follow-user-photo,
        .follow-user-placeholder {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .follow-user-photo {
            object-fit: cover;
        }

        .follow-user-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            background: #7625ed;
            color: white;
            font-size: 25px;
            font-weight: bold;
        }

        .follow-user-info {
            flex: 1;
            min-width: 0;
        }

        .follow-user-info h3 {
            margin: 0 0 6px;
            font-size: 18px;
        }

        .follow-user-info h3 a {
            color: #17123d;
            text-decoration: none;
        }

        .follow-user-info h3 a:hover {
            color: #7625ed;
        }

        .follow-user-info p {
            color: #77758a;
            margin: 0;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .follow-empty {
            background: white;
            padding: 35px;
            border-radius: 12px;
            text-align: center;
            color: #77758a;
        }

        .follow-back {
            display: inline-block;
            margin-bottom: 22px;
            color: #7625ed;
            font-weight: 600;
            text-decoration: none;
        }

        .follow-back:hover {
            text-decoration: underline;
        }

        @media (max-width: 600px) {
            .follow-list-page {
                padding: 15px;
            }

            .follow-user-card {
                padding: 14px;
                gap: 12px;
            }

            .follow-user-photo,
            .follow-user-placeholder {
                width: 52px;
                height: 52px;
            }
        }
    </style>
</head>

<body>

    <%- include('../partials/header') %>

        <main class="container follow-list-page">

            <a href="/author/<%= profileUser.id %>" class="follow-back">
                &larr; Back to Profile
            </a>

            <h1 class="follow-list-heading">
                <%= listType %>
            </h1>

            <p class="follow-list-subheading">
                <%= listType %> of <strong>
                        <%= profileUser.name %>
                    </strong>
            </p>

            <% if (users.length> 0) { %>

                <% users.forEach(user=> { %>

                    <article class="follow-user-card">

                        <% if (user.profile_image) { %>

                            <img src="<%= user.profile_image %>" alt="<%= user.name %>" class="follow-user-photo">

                            <% } else { %>

                                <div class="follow-user-placeholder">
                                    <%= user.name.charAt(0).toUpperCase() %>
                                </div>

                                <% } %>

                                    <div class="follow-user-info">

                                        <h3>
                                            <a href="/author/<%= user.id %>">
                                                <%= user.name %>
                                            </a>
                                        </h3>

                                        <p>
                                            <%= user.bio || 'No bio added yet.' %>
                                        </p>

                                    </div>

                    </article>

                    <% }); %>

                        <% } else { %>

                            <div class="follow-empty">
                                <h3>No <%= listType.toLowerCase() %> yet.</h3>
                                <p>This list is currently empty.</p>
                            </div>

                            <% } %>

        </main>

        <%- include('../partials/footer') %>

</body>

</html>